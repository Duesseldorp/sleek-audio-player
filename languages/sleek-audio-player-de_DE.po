msgstr "(oder <code>%s</code>)"

#: includes/class-player.php:977
msgid "Save and clear cache"
msgstr "Speichern und Cache leeren"

#: includes/class-player.php:979
msgid "Without CORS headers, audio files will be blocked by the browser!"
msgstr "Ohne CORS-Header blockiert der Browser die Audiodateien!"

