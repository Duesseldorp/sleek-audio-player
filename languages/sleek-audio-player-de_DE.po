#: includes/class-player.php:481
msgid "Playlist not found"
msgstr "Playlist nicht gefunden"

#: includes/class-player.php:693
msgid "Player Settings"
msgstr "Player-Einstellungen"

#: includes/class-player.php:694
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-player.php:760
msgid "Sleek Audio Player - Settings"
msgstr "Sleek Audio Player – Einstellungen"

#: includes/class-player.php:768
msgid "CDN URL (BunnyCDN)"
msgstr "CDN-URL (BunnyCDN)"

#: includes/class-player.php:778
msgid "Your BunnyCDN Pull Zone URL (without trailing slash)."
msgstr "Die BunnyCDN-Pull-Zone-URL (ohne abschließenden Schrägstrich)."

#: includes/class-player.php:779
msgid "Leave empty to disable CDN."
msgstr "Leer lassen, um das CDN zu deaktivieren."

#: includes/class-player.php:794
msgid "Enable tracking"
msgstr "Tracking aktivieren"

#: includes/class-player.php:797
msgid "Sends events to Umami when songs are played, completed, or downloaded."
msgstr "Sendet Ereignisse an Umami, wenn Titel abgespielt, beendet oder heruntergeladen werden."

#: includes/class-player.php:801
msgid "Script URL:"
msgstr "Skript-URL:"

#: includes/class-player.php:811
msgid "Website ID:"
msgstr "Website-ID:"

#: includes/class-player.php:821
msgid "Required for tracking in embedded players on external sites."
msgstr "Erforderlich für das Tracking in eingebetteten Playern auf externen Seiten."

#: includes/class-player.php:822
msgid "Leave empty if Umami is already integrated globally on your site."
msgstr "Leer lassen, wenn Umami bereits global auf der Website eingebunden ist."

#: includes/class-player.php:828
msgid "URL Protection"
msgstr "URL-Schutz"

#: includes/class-player.php:837
msgid "Obfuscate audio URLs"
msgstr "Audio-URLs verschleiern"

#: includes/class-player.php:840
msgid "Hides real file URLs and uses time-limited tokens."
msgstr "Verbirgt die echten Datei-URLs und verwendet zeitlich begrenzte Tokens."

#: includes/class-player.php:841
msgid "<strong>Note:</strong> Does not work with CDN! When protection is enabled, CDN will be bypassed."
msgstr "<strong>Hinweis:</strong> Funktioniert nicht mit CDN! Bei aktivem Schutz wird das CDN umgangen."

#: includes/class-player.php:847
msgid "Cover Click"
msgstr "Cover-Klick"

#: includes/class-player.php:856
msgid "Start playback on cover click"
msgstr "Wiedergabe bei Klick auf das Cover starten"

#: includes/class-player.php:859
msgid "When enabled, clicking the cover image starts the first track."
msgstr "Wenn aktiviert, startet ein Klick auf das Coverbild den ersten Titel."

#: includes/class-player.php:860
msgid "Disable this to prevent accidental playback on mobile devices."
msgstr "Deaktivieren, um versehentliche Wiedergabe auf Mobilgeräten zu verhindern."

#: includes/class-player.php:866
msgid "Remember Position"
msgstr "Position merken"

#: includes/class-player.php:875
msgid "Remember playback position"
msgstr "Wiedergabeposition merken"

#: includes/class-player.php:878
msgid "When enabled, the player remembers where the listener stopped."
msgstr "Wenn aktiviert, merkt sich der Player, wo zuletzt gestoppt wurde."

#: includes/class-player.php:879
msgid "Playback resumes from that position on the next visit."
msgstr "Beim nächsten Besuch wird ab dieser Stelle weitergespielt."

#: includes/class-player.php:885
msgid "Visualizer"
msgstr "Visualisierung"

#: includes/class-player.php:892
msgid "Bars (Classic frequency bars)"
msgstr "Balken (Klassische Frequenzbalken)"

#: includes/class-player.php:896
msgid "Mirror Bars (Top & bottom reflection)"
msgstr "Spiegelbalken (Spiegelung oben und unten)"

#: includes/class-player.php:900
msgid "Circular (Radial around center)"
msgstr "Kreis (Radial um die Mitte)"

#: includes/class-player.php:904
msgid "Oscilloscope (Waveform line)"
msgstr "Oszilloskop (Wellenlinie)"

#: includes/class-player.php:908
msgid "Dots (Dancing dots)"
msgstr "Punkte (Tanzende Punkte)"

#: includes/class-player.php:912
msgid "Wave (Filled waveform)"
msgstr "Welle (Gefüllte Wellenform)"

#: includes/class-player.php:916
msgid "Pulse (Pulsing circle)"
msgstr "Puls (Pulsierender Kreis)"

#: includes/class-player.php:920
msgid "Circular Bars (Bars in a circle)"
msgstr "Kreisbalken (Balken im Kreis)"

#: includes/class-player.php:924
msgid "Particles (Floating particles)"
msgstr "Partikel (Schwebende Partikel)"

#: includes/class-player.php:928
msgid "Starburst (Rays from center)"
msgstr "Sternexplosion (Strahlen aus der Mitte)"

#: includes/class-player.php:932
msgid "Orbits (Rotating rings)"
msgstr "Orbits (Rotierende Ringe)"

#: includes/class-player.php:936
msgid "Off (No visualizer)"
msgstr "Aus (Keine Visualisierung)"

#: includes/class-player.php:940
msgid "Choose the default visualization. Users can cycle through all options by double-clicking the cover or pressing V."
msgstr "Legt die Standard-Visualisierung fest. Per Doppelklick auf das Cover oder mit der Taste V lässt sich durch alle Varianten schalten."

#: includes/class-player.php:946
msgid "Save Settings"
msgstr "Einstellungen speichern"

#: includes/class-player.php:950
msgid "Guide: Setting up BunnyCDN"
msgstr "Anleitung: BunnyCDN einrichten"

#. translators: %s is a link to bunny.net
#: includes/class-player.php:955
msgid "Go to %s and create an account"
msgstr "Auf %s gehen und ein Konto anlegen"

#: includes/class-player.php:959
msgid "Create a new <strong>Pull Zone</strong>"
msgstr "Eine neue <strong>Pull Zone</strong> anlegen"

#: includes/class-player.php:960
msgid "Enter your website URL as <strong>Origin URL</strong>:"
msgstr "Die eigene Website-URL als <strong>Origin URL</strong> eintragen:"

#: includes/class-player.php:961
msgid "Copy the Pull Zone URL (e.g. <code>https://yourname.b-cdn.net</code>) and enter it above"
msgstr "Die Pull-Zone-URL kopieren (z. B. <code>https://yourname.b-cdn.net</code>) und oben eintragen"

#: includes/class-player.php:964
msgid "Important: CORS Headers for Audio Files"
msgstr "Wichtig: CORS-Header für Audiodateien"

#: includes/class-player.php:965
msgid "For audio files to play from CDN, CORS headers must be configured:"
msgstr "Damit Audiodateien vom CDN abgespielt werden, müssen CORS-Header konfiguriert sein:"

#: includes/class-player.php:967
msgid "Go to your Pull Zone → <strong>Headers</strong>"
msgstr "In der Pull Zone zu <strong>Headers</strong> wechseln"

#: includes/class-player.php:968
msgid "Add a new header:"
msgstr "Einen neuen Header hinzufügen:"

#: includes/class-player.php:970
msgid "<strong>Header Name:</strong>"
msgstr "<strong>Header-Name:</strong>"

#: includes/class-player.php:971
msgid "<strong>Header Value:</strong>"
msgstr "<strong>Header-Wert:</strong>"

#. translators: %s is the site URL
#: includes/class-player.php:973
